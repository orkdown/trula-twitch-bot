# Токен публичного API Trula
TRULA_TOKEN=your_trula_api_token_here

# Имя твоего Twitch-канала
TWITCH_CHANNEL=your_channel_name

# Имя аккаунта бота
TWITCH_BOT_USERNAME=your_bot_username

# OAuth токен чата (получить на https://twitchtokengenerator.com с правами chat:read, chat:edit)
TWITCH_BOT_OAUTH=oauth:your_oauth_token_here

# Порог голосов для !skip
VOTE_SKIP_THRESHOLD=3

# Кулдаун команд в мс
COMMAND_COOLDOWN_MS=3000

# PIN-код для веб-пульта стримера (http://IP:3333/remote)
REMOTE_PIN=1580

# AI-DJ Голосовой радиоведущий для OBS
AI_DJ_ENABLED=true
# Ключ Google Gemini (необязательно, можно оставить пустым — тогда работают радио-шаблоны Record/DFM)
GEMINI_API_KEY=
# Голос Microsoft Neural TTS (ru-RU-DmitryNeural - мужской радиоведущий, ru-RU-SvetlanaNeural - женский)
AI_DJ_VOICE=ru-RU-DmitryNeural
# Интервал выхода в эфир для фонового плейлиста (каждые N треков; по умолчанию 5)
AI_DJ_TRACK_INTERVAL=5
# Минимальный кулдаун между репликами диджея в секундах
AI_DJ_COOLDOWN_SEC=40
